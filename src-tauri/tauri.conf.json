{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "SVC Studio",
    "version":  "0.1.26",
    "identifier":  "com.svcstudio.app",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "SVC Studio",
                                    "width":  1180,
                                    "height":  720,
                                    "minWidth":  1180,
                                    "minHeight":  720,
                                    "resizable":  true,
                                    "center":  true,
                                    "theme":  "Dark",
                                    "decorations":  true
                                }
                            ],
                "security":  {
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "$HOME/SVCStudio/**",
                                                                     "$TEMP/**"
                                                                 ]
                                                   },
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: asset: http://asset.localhost; media-src \u0027self\u0027 blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
                                 "devCsp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: asset: http://asset.localhost; media-src \u0027self\u0027 blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico",
                                "icons/icon.png"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "offlineInstaller",
                                                              "silent":  true
                                                          },
                                   "nsis":  {
                                                "compression":  "lzma"
                                            }
                               },
                   "resources":  [
                                     "resources/bin/*",
                                     "resources/upstream/**/*",
                                     "resources/assets/**/*",
                                     "resources/pretrain/**/*"
                                 ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://github.com/wisdomWindy/svc-studio/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MzNFOTRCMkVEQjlDQkQKUldTOW5Oc3VTK2t6UnhoRmFYRGExTEF1WERPaUtMeFh6ek1hZG9IL0RiMFh0djhVY29qYnFEWmsK",
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}